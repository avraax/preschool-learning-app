{
  "name": "preschool-learning-app",
  "private": true,
  "version": "1.0.45",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file=.env.local --import ./scripts/js-to-ts-resolve.mjs dev-server.js",
    "test": "node --import ./scripts/js-to-ts-resolve.mjs --test \"src/**/*.test.ts\" \"lib/**/*.test.ts\"",
    "tts:eval": "node --env-file=.env.local --import ./scripts/js-to-ts-resolve.mjs tts-voice-eval.mjs",
    "tts:prebake": "node --env-file=.env.local --import ./scripts/js-to-ts-resolve.mjs prebake-tts.mjs",
    "audit:check": "node --import ./scripts/js-to-ts-resolve.mjs scripts/narration-audit.mjs",
    "audit:approve-all": "node --import ./scripts/js-to-ts-resolve.mjs scripts/narration-audit.mjs --approve-all",
    "dev:vercel": "vercel dev",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "build:debug": "tsc && tsc -p tsconfig.server.json && vite build --mode debug",
    "build:production": "tsc && tsc -p tsconfig.server.json && vite build --minify",
    "build:harness": "tsc && tsc -p tsconfig.server.json && vite build --mode harness",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "auth:migrate": "node --env-file=.env.local --import ./scripts/js-to-ts-resolve.mjs scripts/auth-migrate.mjs",
    "auth:dev-session": "node --env-file=.env.local --import ./scripts/js-to-ts-resolve.mjs scripts/auth-dev-session.mjs",
    "auth:probe-claim": "node --env-file=.env.local --import ./scripts/js-to-ts-resolve.mjs scripts/auth-probe-claim.mjs",
    "dev:staging": "node scripts/dev-staging.mjs",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "verify:tier": "node scripts/verify-build-tier.mjs",
    "staging:init": "node --env-file=.env.local --import ./scripts/js-to-ts-resolve.mjs scripts/staging-init.mjs",
    "staging:seed": "node --env-file=.env.local --import ./scripts/js-to-ts-resolve.mjs scripts/staging-seed.mjs",
    "staging:wipe": "node --env-file=.env.local --import ./scripts/js-to-ts-resolve.mjs scripts/staging-wipe.mjs",
    "probe": "node scripts/baseline-probe.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "icons:generate": "node generate-png-icons.cjs",
    "cap:sync": "node scripts/cap-sync.mjs",
    "context:check": "node scripts/context-budget.mjs",
    "session:cost": "node scripts/session-cost.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.25",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/baloo-2": "^5.2.7",
    "@fontsource/comic-neue": "^5.2.7",
    "@fontsource/exo-2": "^5.2.8",
    "@fontsource/fredoka": "^5.2.10",
    "@google-cloud/speech": "^7.3.2",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "@mui/system": "^9.1.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@vercel/blob": "^2.6.1",
    "@zumer/snapdom": "^2.23.1",
    "better-auth": "^1.6.25",
    "framer-motion": "^12.40.0",
    "howler": "^2.2.4",
    "jose": "^6.2.5",
    "lucide-react": "^1.18.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.17",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.62.1",
    "sharp": "^0.35.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16"
  }
}
