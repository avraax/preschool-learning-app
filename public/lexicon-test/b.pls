<?xml version="1.0" encoding="UTF-8"?>
<!-- Throwaway probe file. Deployed only to find which IPA spelling Azure's LEXICON path accepts for
     "fire"; inline <phoneme> accepts more than the lexicon appears to. Delete once settled. -->
<lexicon version="1.0" xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
         alphabet="ipa" xml:lang="da-DK">
  <lexeme><grapheme>fire</grapheme><phoneme>fiːɐ</phoneme></lexeme>
</lexicon>
